---
import '../styles/global.css';
import { Logomark } from '../components/landing/glyphs';
import CopyBlock from '../components/guide/CopyBlock';
import { EXAMPLE_EVENT, GROK_PROMPT } from '../content/grokPrompt';
import { grokGuidePaths, localeLabels, localePaths, locales } from '../lib/copy';
import type { Copy, Locale } from '../lib/copy';

interface Props {
  copy: Copy;
  locale: Locale;
}

const { copy, locale } = Astro.props;
const g = copy.grok;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <title>{g.meta.title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={g.meta.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function(){
        var t = localStorage.getItem('xarji-theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <script>
      import mixpanel from "mixpanel-browser";
      mixpanel.init('ab17d8b7a30ecf77566861cbe57130bd', {
        autocapture: true,
        record_sessions_percent: 100,
        api_host: 'https://api-eu.mixpanel.com',
      });
      mixpanel.identify(mixpanel.get_distinct_id());
      mixpanel.people.set_once({ '$created': new Date().toISOString() });
    </script>
    <link rel="alternate" hreflang="en" href={grokGuidePaths.en} />
    <link rel="alternate" hreflang="ka" href={grokGuidePaths.ka} />
    <link rel="alternate" hreflang="x-default" href={grokGuidePaths.en} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Instrument+Serif:ital@0;1&family=Noto+Sans+Georgian:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href={localePaths[locale]}>
        <Logomark size={28} />
        <span>{g.homeLabel}</span>
      </a>
      <nav class="locale" aria-label={copy.nav.localeSwitchAria}>
        {locales.map((l) => (
          <a href={grokGuidePaths[l]} aria-current={l === locale ? 'page' : undefined}>{localeLabels[l]}</a>
        ))}
      </nav>
    </header>

    <main class="wrap">
      <div class="eyebrow">{g.eyebrow}</div>
      <h1>{g.title}</h1>
      <p class="lead">{g.lead}</p>

      <div class="privacy">
        <strong>{g.privacyTitle}</strong>
        <p>{g.privacyBody}</p>
      </div>

      <section>
        <h2>{g.stepsTitle}</h2>
        <ol class="steps">
          {g.steps.map((s, i) => (
            <li>
              <span class="num">{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section>
        <h2>{g.promptTitle}</h2>
        <p class="sub">{g.promptSub}</p>
        <CopyBlock client:visible name="grok-prompt.txt" text={GROK_PROMPT} copyLabel={g.copyLabel} copiedLabel={g.copiedLabel} maxHeight={440} />
      </section>

      <section>
        <h2>{g.eventTitle}</h2>
        <p class="sub">{g.eventSub}</p>
        <CopyBlock client:visible name="xarji.payment/v1" text={EXAMPLE_EVENT} copyLabel={g.copyLabel} copiedLabel={g.copiedLabel} />
      </section>

      <section>
        <h2>{g.notesTitle}</h2>
        <ul class="notes">
          {g.notes.map((n) => <li>{n}</li>)}
        </ul>
      </section>

      <a class="back" href={localePaths[locale]}>{g.backLabel}</a>
    </main>
  </body>
</html>

<style>
  body { color: var(--land-text); }
  .top {
    max-width: 760px; margin: 0 auto; padding: 18px var(--sh);
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--land-text); text-decoration: none; font-size: 15px; font-weight: 700; }
  .locale { display: flex; gap: 2px; padding: 3px; background: var(--land-panel); border: 1px solid var(--land-line); border-radius: 10px; }
  .locale a {
    padding: 5px 9px; border-radius: 7px; text-decoration: none;
    font: 700 11px/1.2 'JetBrains Mono', ui-monospace, monospace; letter-spacing: 0.5px; color: var(--land-muted);
  }
  .locale a[aria-current='page'] { background: var(--land-text); color: var(--land-bg); }

  .wrap { max-width: 760px; margin: 0 auto; padding: clamp(24px, 5vw, 56px) var(--sh) 64px; }
  .eyebrow {
    font: 700 11.5px 'JetBrains Mono', ui-monospace, monospace; color: var(--land-accent);
    letter-spacing: 1.4px; text-transform: uppercase;
  }
  h1 { margin: 12px 0 16px; font-size: clamp(36px, 6vw, 56px); font-weight: 700; letter-spacing: -1.8px; line-height: 1.04; text-wrap: balance; }
  .lead { margin: 0; font-size: 17px; line-height: 1.55; color: var(--land-muted); max-width: 620px; }

  .privacy { margin-top: 28px; padding: 16px 18px; border-radius: 14px; background: var(--land-accent-dim); border: 1px solid var(--land-accent-soft); }
  .privacy strong { display: block; margin-bottom: 4px; font-size: 14.5px; }
  .privacy p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--land-muted); }

  section { margin-top: 56px; }
  h2 { margin: 0 0 8px; font-size: 26px; font-weight: 700; letter-spacing: -0.6px; }
  .sub { margin: 0; font-size: 15px; line-height: 1.55; color: var(--land-muted); }

  .steps { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .steps li { display: flex; gap: 14px; padding: 16px 18px; background: var(--land-panel); border: 1px solid var(--land-line); border-radius: 14px; }
  .num {
    flex-shrink: 0; width: 28px; height: 28px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    background: var(--land-accent-soft); color: var(--land-accent);
    font: 700 13px 'JetBrains Mono', ui-monospace, monospace;
  }
  .steps h3 { margin: 3px 0 4px; font-size: 15.5px; font-weight: 700; }
  .steps p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--land-muted); }

  .notes { margin: 16px 0 0; padding-left: 18px; display: flex; flex-direction: column; gap: 8px; font-size: 14.5px; line-height: 1.6; color: var(--land-muted); }

  .back { display: inline-block; margin-top: 56px; font-size: 14px; color: var(--land-muted); text-decoration: none; }
  .back:hover { color: var(--land-text); }
</style>
