# Copy to .env and fill in real values. .env is gitignored.

# InstantDB app that collects newsletter signups from the landing form.
# Create at https://instantdb.com/dash — the UUID in the URL is the app ID.
# Safe to expose (InstantDB sends it with every client request); keep in .env
# only so contributors can point at different dev/staging apps.
PUBLIC_INSTANT_LANDING_APP_ID=00000000-0000-0000-0000-000000000000
